    els.input.value = state.options.join('\n');
    saveState(); render();
    showWinner(winner, actualColors()[winnerIndex % actualColors().length]);
  }
  function showWinner(winner, color) {
    modalLastFocus = document.activeElement;
    els.winnerTitle.innerHTML = "It's your turn, <em>" + escapeHtml(winner) + '.</em>';
    els.winnerSlice.style.background = color;
    els.winnerMessage.textContent = state.removeWinner ? 'A lovely choice. It has taken its bow from the wheel.' : 'A very good choice, if we may say so.';
    makeConfetti();
    els.modal.hidden = false;
    els.closeWinner.focus();
  }
  function closeWinner() {
    els.modal.hidden = true; els.confetti.innerHTML = '';
    if (modalLastFocus) modalLastFocus.focus();
  }
  function makeConfetti() {
    var colors = actualColors();
    els.confetti.innerHTML = Array.from({ length: 34 }, function (_, index) {
      return '<i style="left:' + (Math.random() * 100) + '%;background:' + colors[index % colors.length] + ';animation-delay:' + (Math.random() * .7) + 's;animation-duration:' + (2 + Math.random() * 1.4) + 's"></i>';
    }).join('');
  }
  function flashSaved() {
    els.save.innerHTML = '<span class="tt-save-dot"></span> Saving…';
    clearTimeout(saveTimer); saveTimer = setTimeout(saveState, 260);
  }

  els.input.addEventListener('input', function () { state.options = normalize(els.input.value); render(); flashSaved(); });
  els.input.addEventListener('blur', saveState);
  els.spin.addEventListener('click', spin);
  $('ttShuffleButton').addEventListener('click', function () { state.options.sort(function () { return Math.random() - .5; }); els.input.value = state.options.join('\n'); render(); flashSaved(); });
  $('ttRandomColorsButton').addEventListener('click', function () {
    state.colors = Array.from({ length: 8 }, function () { return 'hsl(' + Math.floor(Math.random() * 360) + ' 58% ' + (45 + Math.floor(Math.random() * 18)) + '%)'; });
    render(); flashSaved();
  });
  $('ttClearButton').addEventListener('click', function () {
    if (!state.options.length || window.confirm('Clear every option from the wheel?')) { state.options = []; els.input.value = ''; render(); flashSaved(); }
  });
  els.duration.addEventListener('input', function (event) { state.duration = Number(event.target.value); els.durationValue.textContent = state.duration + ' sec'; flashSaved(); });
  els.remove.addEventListener('change', function (event) { state.removeWinner = event.target.checked; flashSaved(); });
  els.duplicates.addEventListener('change', function (event) { state.duplicates = event.target.checked; state.options = normalize(els.input.value); els.input.value = state.options.join('\n'); render(); flashSaved(); });
  els.themeToggle.addEventListener('click', function () { state.dark = !state.dark; setThemeMode(); render(); flashSaved(); });
  root.querySelectorAll('.tt-theme-swatch').forEach(function (button) {
    button.addEventListener('click', function () { state.theme = button.dataset.theme; state.colors = null; render(); flashSaved(); });
  });
  els.list.addEventListener('click', function (event) {
    var button = event.target.closest('button'); if (!button) return;
    var index = Number(button.dataset.index);
    if (button.classList.contains('tt-delete-row')) { state.options.splice(index, 1); els.input.value = state.options.join('\n'); editingIndex = null; render(); flashSaved(); }
    if (button.classList.contains('tt-edit-row')) { editingIndex = index; renderList(); }
  });
  els.list.addEventListener('keydown', function (event) {
    if (!event.target.matches('[data-edit-input]')) return;
    var index = Number(event.target.dataset.editInput);
