<script>
/* Turntable — framework-free: one small state object, one canvas, no dependencies.
   IDs/classes are prefixed with "tt" and the whole thing runs inside an IIFE so it
   won't collide with the rest of a Blogger page or template. */
(function () {
  'use strict';

  var root = document.getElementById('turntable-app');
  if (!root || root.getAttribute('data-tt-initialized') === 'true') return;
  root.setAttribute('data-tt-initialized', 'true');

  var palettes = {
    citrus: { name: 'Citrus club', colors: ['#ef6c4e', '#2f8d86', '#f2c94c', '#d8a24a', '#bd5c54', '#73a39a', '#e79b62', '#477c78'] },
    tide: { name: 'Tidal pool', colors: ['#276b83', '#e78e62', '#e9c46a', '#4d918f', '#d96f65', '#8db6aa', '#315e76', '#edb071'] },
    berry: { name: 'Berry dusk', colors: ['#9e4d69', '#ed8f78', '#d8b35c', '#60466e', '#cb6d75', '#87a487', '#b85b64', '#e4c185'] },
    meadow: { name: 'Meadow party', colors: ['#557d63', '#e1865b', '#d8bc63', '#4e7180', '#b9655e', '#86a78a', '#d5a56c', '#6c7781'] }
  };
  var defaultOptions = ['Mina', 'Theo', 'Rae', 'Jun'];
  var storageKey = 'turntable-state-v1';
  var $ = function (id) { return root.querySelector('#' + id); };
  var els = {
    input: $('ttOptionsInput'), list: $('ttOptionsList'), empty: $('ttEmptyOptions'),
    countBadge: $('ttCountBadge'), count: $('ttWheelCount'), charCount: $('ttCharCount'), spin: $('ttSpinButton'),
    spinSubtext: $('ttSpinSubtext'), wheelHint: $('ttWheelHint'), canvas: $('ttWheelCanvas'), stage: $('ttWheelStage'),
    duration: $('ttDurationRange'), durationValue: $('ttDurationValue'), remove: $('ttRemoveWinner'),
    duplicates: $('ttAllowDuplicates'), themeName: $('ttThemeName'), modal: $('ttWinnerModal'),
    winnerTitle: $('ttWinnerTitle'), winnerSlice: $('ttWinnerSlice'), winnerMessage: $('ttWinnerMessage'),
    confetti: $('ttConfetti'), save: $('ttSaveStatus'), themeToggle: $('ttThemeToggle'), closeWinner: $('ttCloseWinner'),
    spinAgain: $('ttSpinAgainButton')
  };
  var ctx = els.canvas.getContext('2d');
  var state = loadState();
  var currentRotation = 0;
  var spinning = false;
  var editingIndex = null;
  var modalLastFocus = null;
  var saveTimer = null;

  function safeStorage() {
    try {
      var testKey = '__tt_test__';
      window.localStorage.setItem(testKey, '1');
      window.localStorage.removeItem(testKey);
      return window.localStorage;
    } catch (e) {
      return null;
    }
  }
  var storage = safeStorage();

  function loadState() {
    try {
      if (storage) {
        var saved = JSON.parse(storage.getItem(storageKey));
        if (saved && Array.isArray(saved.options)) {
          return {
            options: saved.options.filter(Boolean).map(String).slice(0, 80),
            duration: Number(saved.duration) || 6,
            removeWinner: Boolean(saved.removeWinner),
            duplicates: Boolean(saved.duplicates),
            theme: palettes[saved.theme] ? saved.theme : 'citrus',
            dark: Boolean(saved.dark),
            colors: Array.isArray(saved.colors) ? saved.colors : null
          };
        }
      }
    } catch (_) {}
    return { options: defaultOptions.slice(), duration: 6, removeWinner: false, duplicates: false, theme: 'citrus', dark: false, colors: null };
  }
  function saveState() {
    if (storage) {
      try { storage.setItem(storageKey, JSON.stringify(state)); } catch (_) {}
    }
    els.save.innerHTML = '<span class="tt-save-dot"></span> Saved locally';
  }
  function setThemeMode() {
    root.classList.toggle('tt-dark', state.dark);
    els.themeToggle.setAttribute('aria-label', state.dark ? 'Switch to light mode' : 'Switch to dark mode');
    els.themeToggle.querySelector('.tt-icon-sun').style.display = state.dark ? 'none' : 'block';
    els.themeToggle.querySelector('.tt-icon-moon').style.display = state.dark ? 'block' : 'none';
  }
  function actualColors() {
    var palette = palettes[state.theme].colors;
    return state.colors && state.colors.length ? state.colors : palette;
  }
  function normalize(raw) {
    var values = raw.split(/\r?\n/).map(function (value) { return value.trim(); }).filter(Boolean);
    if (!state.duplicates) values = values.filter(function (value, index) { return values.indexOf(value) === index; });
    return values.slice(0, 80);
  }
  function render() {
    state.options = normalize(els.input.value);
    els.input.value = state.options.join('\n');
    els.countBadge.textContent = state.options.length;
    els.count.textContent = state.options.length + (state.options.length === 1 ? ' option' : ' options');
    els.charCount.textContent = els.input.value.length;
    els.empty.hidden = state.options.length > 0;
    els.list.hidden = state.options.length === 0;
    els.spin.disabled = state.options.length < 2 || spinning;
    els.spinSubtext.textContent = state.options.length < 2 ? 'Add at least two options to begin' : (spinning ? 'The wheel is deciding…' : 'Press Space anytime to spin');
    els.wheelHint.textContent = state.options.length ? 'Ready for a worthy choice' : 'Waiting for a worthy choice';
    els.duration.value = state.duration;
    els.durationValue.textContent = state.duration + ' sec';
    els.remove.checked = state.removeWinner;
    els.duplicates.checked = state.duplicates;
    els.themeName.textContent = palettes[state.theme].name;
    root.querySelectorAll('.tt-theme-swatch').forEach(function (button) { button.classList.toggle('active', button.dataset.theme === state.theme); });
    renderList();
    drawWheel();
  }
  function icon(name) {
    if (name === 'edit') return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 16-.8 4.8L8 20l10.4-10.4a2.3 2.3 0 0 0-3.2-3.2L4 16Z"></path><path d="m13.7 7.3 3 3"></path></svg>';
    return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M10 11v5M14 11v5M6 7l1 13h10l1-13M9 7V4h6v3"></path></svg>';
  }
  function renderList() {
    els.list.innerHTML = state.options.map(function (option, index) {
      var color = actualColors()[index % actualColors().length];
      var content = editingIndex === index
        ? '<input class="tt-option-edit-input" value="' + escapeHtml(option) + '" aria-label="Edit option ' + (index + 1) + '" data-edit-input="' + index + '" />'
        : '<span class="tt-option-name" title="' + escapeHtml(option) + '">' + escapeHtml(option) + '</span>';
      return '<div class="tt-option-row" style="animation-delay:' + (index * 25) + 'ms" data-row="' + index + '">' +
        '<span class="tt-option-color" style="background:' + color + '"></span><span class="tt-option-index">' + String(index + 1).padStart(2, '0') + '</span>' +
        content + '<span class="tt-row-actions">' +
        '<button class="tt-row-button tt-edit-row" type="button" aria-label="Edit ' + escapeHtml(option) + '" data-index="' + index + '">' + icon('edit') + '</button>' +
        '<button class="tt-row-button tt-delete-row" type="button" aria-label="Delete ' + escapeHtml(option) + '" data-index="' + index + '">' + icon('delete') + '</button></span></div>';
    }).join('');
    if (editingIndex !== null) {
      var input = els.list.querySelector('[data-edit-input]');
      if (input) { input.focus(); input.select(); }
    }
  }
  function escapeHtml(value) {
    return value.replace(/[&<>"']/g, function (char) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char];
    });
  }
  function drawWheel() {
    var rect = els.canvas.getBoundingClientRect();
    var size = Math.max(300, rect.width || 500);
    var dpr = window.devicePixelRatio || 1;
    els.canvas.width = size * dpr; els.canvas.height = size * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, size, size);
    var cx = size / 2, cy = size / 2, radius = size / 2 - 7;
    ctx.save(); ctx.translate(cx, cy); ctx.rotate(currentRotation);
    var options = state.options.length ? state.options : ['Add options', 'to begin'];
    var slice = Math.PI * 2 / options.length;
    options.forEach(function (option, index) {
      var start = -Math.PI / 2 + index * slice, end = start + slice;
      ctx.beginPath(); ctx.moveTo(0, 0); ctx.arc(0, 0, radius, start, end); ctx.closePath();
      ctx.fillStyle = actualColors()[index % actualColors().length]; ctx.fill();
      ctx.lineWidth = 2; ctx.strokeStyle = state.dark ? '#232b29' : '#f7f2ea'; ctx.stroke();
      if (state.options.length) {
        ctx.save(); ctx.rotate(start + slice / 2); ctx.translate(radius * .66, 0); ctx.rotate(Math.PI / 2);
        var fontSize = Math.max(10, Math.min(17, 210 / options.length));
        ctx.font = '600 ' + fontSize + 'px "DM Sans", sans-serif'; ctx.fillStyle = contrastColor(actualColors()[index % actualColors().length]);
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(option.length > 17 ? option.slice(0, 16) + '…' : option, 0, 0); ctx.restore();
      }
    });
    ctx.beginPath(); ctx.arc(0, 0, radius, 0, Math.PI * 2); ctx.lineWidth = 4; ctx.strokeStyle = state.dark ? '#f6efe4' : '#202421'; ctx.stroke();
    ctx.restore();
  }
  function contrastColor(hex) {
    var num = parseInt(hex.slice(1), 16);
    return ((num >> 16) * 299 + ((num >> 8) & 255) * 587 + (num & 255) * 114) / 1000 > 156 ? '#202421' : '#fffaf2';
  }
  function spin() {
    if (spinning || state.options.length < 2) return;
    spinning = true; render();
    var count = state.options.length, winnerIndex = Math.floor(Math.random() * count);
    var slice = Math.PI * 2 / count;
    var target = -(winnerIndex * slice + slice / 2);
    var turns = 5 + Math.floor(Math.random() * 3);
    var startRotation = currentRotation, endRotation = currentRotation + turns * Math.PI * 2 + normalizeAngle(target - currentRotation);
    var startTime = performance.now(), duration = state.duration * 1000;
    var ease = function (t) { return 1 - Math.pow(1 - t, 4); };
    function frame(now) {
      var progress = Math.min(1, (now - startTime) / duration);
      currentRotation = startRotation + (endRotation - startRotation) * ease(progress);
      drawWheel();
      if (progress < 1) requestAnimationFrame(frame);
      else finishSpin(winnerIndex);
    }
    requestAnimationFrame(frame);
  }
  function normalizeAngle(angle) {
    while (angle < 0) angle += Math.PI * 2;
    while (angle >= Math.PI * 2) angle -= Math.PI * 2;
    return angle;
  }
